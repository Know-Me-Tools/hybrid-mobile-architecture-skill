{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/skill-activation.py",
            "description": "Advisory activation from the canonical KnowMe Builder manifest; owns no lifecycle state"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/a11y-reminder.py",
            "description": "TJ-ARCH-MOB-001: remind to run the a11y-gate after UI edits"
          }
        ]
      }
    ]
  }
}
