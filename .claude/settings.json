{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "description": "Advisory activation from the canonical KnowMe Builder manifest; owns no lifecycle state",
            "args": [
              ".claude/hooks/skill-activation.mjs"
            ]
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "description": "TJ-ARCH-MOB-001: remind to run the a11y-gate after UI edits",
            "args": [
              ".claude/hooks/a11y-reminder.mjs"
            ]
          }
        ]
      }
    ]
  }
}
