{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "compass": {
      "command": "compass",
      "args": [
        "serve",
        "--transport",
        "stdio"
      ]
    }
  }
}
