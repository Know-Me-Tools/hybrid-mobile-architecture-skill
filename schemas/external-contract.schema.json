{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheusags.ai/schemas/knowme-external-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "minimumVersion", "requiredFeatures", "authority"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "minimumVersion": { "type": "string", "minLength": 1 },
    "requiredFeatures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
